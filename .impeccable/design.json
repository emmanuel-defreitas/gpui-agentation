      "html": "<label class=\"ds-label\" for=\"ds-note\">Comment</label><textarea id=\"ds-note\" class=\"ds-note\" placeholder=\"Describe what should change\u2026\"></textarea>",
      "css": ".ds-label{display:block;color:#392700;font:600 13px Inter,Arial,sans-serif;margin-bottom:8px}.ds-note{min-height:96px;width:100%;resize:vertical;border:1px solid #c58a15;border-radius:5px;background:#fff4db;color:#392700;padding:11px;font:13px/1.6 Inter,Arial,sans-serif}.ds-note::placeholder{color:#786237}.ds-note:focus-visible{outline:2px solid var(--focus,#986300);outline-offset:4px}"
    },
    {
