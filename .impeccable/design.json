  "narrative": {
    "northStar": "Native developer workbench",
    "overview": "The native developer workbench carries the visual vocabulary of the annotation product into a reading-focused website. Cool neutral surfaces, graphite controls, and amber annotation marks make the interactive preview feel related to the native interface.\n\nInter provides practical reading and control text; JetBrains Mono identifies source, commands, and technical metadata. Spacious documentation sections surround a denser preview. This specification describes the Astro website only; it does not define the native crate\u2019s API or native UI tokens.",
    "keyCharacteristics": [
      "Neutral reading surfaces with amber annotation state.",
      "Bundled Inter and JetBrains Mono for continuity with the native product.",
      "Quiet borders and restrained shadows; compact working controls.",
      "Responsive documentation with a functional, explicitly simulated preview."
    ],
    "rules": [
      {
        "name": "The Annotation Accent Rule",
        "body": "Amber identifies annotation state; ordinary reference surfaces remain neutral.",
        "section": "colors"
      },
      {
        "name": "The Source Voice Rule",
        "body": "Use the mono family for commands, source references, and technical metadata; use Inter for prose and actions.",
        "section": "typography"
      },
      {
        "name": "The Working Layer Rule",
        "body": "Reserve floating depth for the interactive workbench, annotations, and dialog; documentation containers rely on borders and tone.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic surface and text variables so light and dark appearance stay coherent.",
      "Do reserve amber for annotation identity, selection, and related focus states.",
      "Do pair readable Inter prose with JetBrains Mono source and technical metadata.",
      "Do retain visible keyboard focus and honor reduced-motion preferences.",
      "Do keep the browser preview visibly identified as a simulation."
    ],
    "donts": [
