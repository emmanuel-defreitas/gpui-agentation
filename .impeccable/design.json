      "html": "<nav class=\"ds-nav\" aria-label=\"Documentation\"><a href=\"#installation\" aria-current=\"location\">Installation</a><a href=\"#setup\">Native setup</a><a href=\"#mcp\">MCP bridge</a></nav>",
