      "kind": "button",
      "refersTo": "button-primary",
      "description": "Installation action.",
      "html": "<button class=\"ds-button\">Install gpui-agentation</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line,#dde3e3);border-radius:7px;padding:10px 16px;font:600 13px Inter,Arial,sans-serif;cursor:pointer;transition:background .15s,color .15s}.ds-button:hover{filter:brightness(.96)}.ds-button:focus-visible{outline:2px solid var(--focus,#986300);outline-offset:4px}.ds-button{background:var(--text,#202626);color:var(--bg,#fafbfb);border-color:var(--text,#202626)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary preview or example action.",
      "html": "<button class=\"ds-button\">Copy feedback</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line,#dde3e3);border-radius:7px;padding:10px 16px;font:600 13px Inter,Arial,sans-serif;cursor:pointer;transition:background .15s,color .15s}.ds-button:hover{filter:brightness(.96)}.ds-button:focus-visible{outline:2px solid var(--focus,#986300);outline-offset:4px}.ds-button{background:var(--surface,#fff);color:var(--text,#202626)}.ds-button:hover{background:var(--sunken,#f1f3f3)}"
