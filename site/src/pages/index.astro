---
import { createHash } from 'node:crypto';
import bannerSource from '../illustrations/banner.mjs?raw';
import '../styles/site.css';
import CodeBlock from '../components/CodeBlock.astro';
import FeatureMotion from '../components/FeatureMotion.astro';
const base = import.meta.env.BASE_URL;
const pagePrompt = 'Read https://emmanuel-defreitas.github.io/gpui-agentation/index.md and help me understand and integrate gpui-agentation in my GPUI app. Ask about my app before making changes.';
const claudeLink = `claude-cli://open?q=${encodeURIComponent(pagePrompt)}`;
const cursorLink = `https://cursor.com/link/prompt?text=${encodeURIComponent(pagePrompt)}`;
const bannerVersion = createHash('sha256')
  .update(bannerSource)
  .digest('hex').slice(0, 12);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="Point at your native GPUI interface, leave a precise annotation, and give your coding agent the context to fix it. Try the preview and install gpui-agentation.">
  <meta property="og:title" content="gpui-agentation — native UI feedback for agents">
  <meta property="og:description" content="Annotate your GPUI app. Give your agent the context. A native Rust library with an optional MCP bridge.">
  <meta property="og:type" content="website">
  <title>gpui-agentation — native UI feedback for agents</title>
  <link rel="icon" href={`${base}assets/mark.svg`} type="image/svg+xml">
  <script>import '../scripts/app.js'; import '../scripts/motion.ts';</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<svg class="symbols" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
  <symbol id="i-play" viewBox="0 0 24 24"><path d="m9 5 10 7-10 7V5Z"/></symbol>
  <symbol id="i-pause" viewBox="0 0 24 24"><path d="M8 5v14M16 5v14"/></symbol>
  <symbol id="i-inspect" viewBox="0 0 24 24"><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6M8 12h8m-4-4v8"/></symbol>
  <symbol id="i-box" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 19 19 5M7 5h12v12"/></symbol>
  <symbol id="i-pen" viewBox="0 0 24 24"><path d="m4 16 12-12a2.8 2.8 0 0 1 4 4L8 20l-5 1 1-5Zm10-10 4 4M12 21h9"/></symbol>
  <symbol id="i-comment" viewBox="0 0 24 24"><path d="M21 11a8.8 8.8 0 0 1-9 9 10 10 0 0 1-4-.8L3 21l1.8-5a10 10 0 0 1-.8-4 8.8 8.8 0 0 1 9-9 8.8 8.8 0 0 1 8 8Z"/></symbol>
  <symbol id="i-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3"/></symbol>
  <symbol id="i-github" viewBox="0 0 24 24"><path d="M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-3c3-.4 6-1.5 6-6a5 5 0 0 0-1-3.5 5 5 0 0 0-.1-3.5S17.7 1.6 15 3a12 12 0 0 0-6 0C6.3 1.6 5.1 2 5.1 2A5 5 0 0 0 5 5.5 5 5 0 0 0 4 9c0 4.5 3 5.6 6 6a3.5 3.5 0 0 0-1 3v4"/></symbol>
  <symbol id="i-theme" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 4v16M12 4a8 8 0 0 1 0 16"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16"/></symbol>
</svg>
<header class="header wrap">
  <a href="#" class="brand" aria-label="gpui-agentation home"><img src={`${base}assets/mark.svg`} alt="" width="27" height="27"><span>gpui-agentation</span></a>
  <nav aria-label="Main navigation"><a href="#preview">Preview</a><a href="#installation">Install</a><a href="#setup">Setup</a><a href="#skills">Skills</a><a href="#customization">Customize</a></nav>
  <div class="header-actions"><button class="icon-button" id="theme-toggle" aria-label="Switch to dark appearance"><svg><use href="#i-theme"/></svg></button><a class="github-link" href="https://github.com/emmanuel-defreitas/gpui-agentation" aria-label="Source on GitHub"><svg><use href="#i-github"/></svg><span>GitHub</span></a></div>
</header>
<div class="page-tools wrap">
  <details class="page-share" id="page-share">
    <summary><svg aria-hidden="true"><use href="#i-copy"/></svg>Copy this page<svg class="share-chevron" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
    <div class="page-share-panel">
      <button id="copy-page" data-markdown={`${base}index.md`}><svg aria-hidden="true"><use href="#i-copy"/></svg><span>Copy as Markdown<small>Plain text, ready for your agent</small></span></button>
      <a href={claudeLink}><span class="share-provider" aria-hidden="true">Cl</span><span>Open in Claude Code<small>Start with a prefilled prompt</small></span><span aria-hidden="true">↗</span></a>
      <a href="https://chatgpt.com/codex" target="_blank" rel="noopener noreferrer" id="open-codex" data-prompt={pagePrompt}><span class="share-provider" aria-hidden="true">Co</span><span>Open in Codex<small>Copies page context · paste to start</small></span><span aria-hidden="true">↗</span></a>
      <a href={cursorLink} target="_blank" rel="noopener noreferrer"><span class="share-provider" aria-hidden="true">Cu</span><span>Open in Cursor<small>Start with a prefilled prompt</small></span><span aria-hidden="true">↗</span></a>
      <a class="markdown-link" href={`${base}index.md`} target="_blank" rel="noopener noreferrer">View Markdown <span aria-hidden="true">↗</span></a>
    </div>
  </details>
</div>
<main id="main">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div><h1 id="hero-title">Point it out.<br>Build it better.</h1><p>Visual feedback for your native GPUI app.<br>Annotate the interface. Give your agent the context.</p><a class="button primary" href="#installation">Add to your app <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="https://crates.io/crates/gpui-agentation/0.4.2">Rust crate <span class="version">v0.4.2</span></a></div>
    <div class="hero-aside"><span class="pin static-pin">1</span><p>A precise place.<br>A clear comment.<br>A shorter path to the fix.</p></div>
  </section>
  <section class="preview-section wrap" id="preview" aria-labelledby="preview-title">
    <div class="section-top"><h2 id="preview-title">See feedback take shape.</h2><span>Illustrated demo</span></div>
    <figure class="demo-film">
      <img id="demo-film" src={`${base}assets/motion/dashboard-demo-poster.svg?v=${bannerVersion}`} data-gif={`${base}assets/motion/dashboard-demo.gif?v=${bannerVersion}`} data-poster={`${base}assets/motion/dashboard-demo-poster.svg?v=${bannerVersion}`} width="1120" height="650" alt="Illustrated dashboard annotation sequence: a cursor selects cards, activity rows, an export button, and sidebar icons; comments are typed into amber popovers and saved as numbered pins." fetchpriority="high">
      <figcaption><span>Inspect. Comment. Hand off.</span><button class="film-control" id="film-toggle" aria-label="Play illustrated demo" hidden><svg aria-hidden="true"><use href="#i-play"/></svg><span>Play</span></button></figcaption>
    </figure>
    <p class="film-note">An illustrated look at the workflow. The installed tools run inside your native GPUI app.</p>
    <div class="feature-grid"><FeatureMotion kind="inspect"/><FeatureMotion kind="draw"/><FeatureMotion kind="handoff"/></div>
  </section>
  <div class="docs-layout wrap">
    <aside class="docs-nav"><span>Get started</span><a href="#installation">Installation</a><a href="#setup">Native app setup</a><a href="#mcp">Connect your agent</a><a href="#skills">Agent skills</a><a href="#customization">Customization</a><a href="#credits">Credits</a></aside>
    <div class="docs-content">
      <section id="installation" class="doc-section"><h2>Small package.<br>Native feedback.</h2><p>Add the library to your GPUI app. Install the bridge separately if you want your coding agent to read and respond to annotations through MCP.</p>
        <div class="requirements"><span>Rust 1.95+</span><span>GPUI 0.3.8</span><span>Debug builds</span><span>MIT</span></div>
        <h3>01 <span>Add the native library</span></h3><p>In your app’s <code>Cargo.toml</code>, enable <code>native</code> and turn off default features. Ely’s pinned source and assets come bundled in the package.</p>
        <CodeBlock label="Cargo.toml" copyLabel="Copy native dependencies" language="toml" code={`[dependencies]
gpui-agentation = { version = "0.4.2", default-features = false, features = ["native"] }
gpui = { package = "gpui-pre", version = "=0.3.8", default-features = false, features = ["stacker"] }`} />
        <p class="small-note">Use the same <code>gpui-pre</code> version and registry source throughout your app. Other GPUI sources produce incompatible Rust types.</p>
        <h3>02 <span>Install the optional MCP bridge</span></h3><CodeBlock label="Terminal" copyLabel="Copy bridge installation command" language="shell" code={`cargo install gpui-agentation --version 0.4.2 --locked`} /><p>The default install builds the portable bridge executable. It does not compile GPUI or Ely and does not launch your app.</p>
      </section>
      <section id="setup" class="doc-section"><h2>Wire it in once.</h2><p>Keep the integration at your application root. Register meaningful component boundaries you want to select, rather than wrapping every widget.</p><p class="notice">These instructions target the 0.4.2 Agentation API. Gate all annotation imports, initialization, fields, and render hooks with <code>#[cfg(debug_assertions)]</code>: release builds expose no annotation API.</p>
        <ol class="setup-steps"><li><h3>Initialize Agentation</h3><p>Configure <code>gpui_agentation::Assets</code> on your Application, then call <code>gpui_agentation::init(cx)</code> in the launch callback. Agentation handles its bundled Ely setup and focus internally.</p></li><li><h3>Mount once per window</h3><CodeBlock label="Root initialization · debug only" copyLabel="Copy Agentation initialization" language="rust" code={`let feedback = gpui_agentation::Agentation::mount(
    "My app", "gpui://my-app/home",
    "target/agentation/feedback.json", 4748, window, cx,
)?;`} /></li><li><h3>Render your screen</h3><CodeBlock label="Root render · debug only" copyLabel="Copy screen registration" language="rust" code={`self.feedback.root(
    "home", "Home screen", content, window, cx,
)`} /><p>Ordinary controls need no wrappers. Add <code>target(id, label, child)</code> only for finer inspection targets. Keep IDs stable and unique.</p></li></ol>
      </section>
      <section id="mcp" class="doc-section"><h2>Give your agent<br>the whole comment.</h2><p>Run your native app in debug mode, then add the installed bridge to an MCP client that supports stdio servers. The bridge forwards requests to the app’s local listener.</p>
        <CodeBlock label="MCP client configuration · JSON" copyLabel="Copy MCP client configuration" language="json" code={`{
  "mcpServers": {
    "gpui_agentation": {
      "command": "gpui-agentation",
      "args": ["--url", "http://127.0.0.1:4748/mcp"]
    }
  }
}`} /><p>Use your client’s equivalent server configuration if its schema differs. The agent can read pending annotations, acknowledge them, reply, and resolve or dismiss feedback. Keep the native app running while using these tools.</p><p class="small-note">Loopback only. No API key. Browser origins are rejected by the native API. The site’s illustrations do not connect to your local server.</p><a class="inline-link" href="https://registry.modelcontextprotocol.io/v0.1/servers/io.github.emmanuel-defreitas%2Fgpui-agentation/versions/0.4.2">View the MCP Registry entry <span aria-hidden="true">↗</span></a>
      </section>
      <section id="skills" class="doc-section"><h2>Give your agent<br>a working guide.</h2><p>Two reusable skills help your agent install gpui-agentation and explore feedback from a running app. Choose the workflow you need.</p>
        <dl class="options">
          <div><dt><a class="inline-link" href="https://github.com/emmanuel-defreitas/gpui-agentation/blob/dev/skills/gpui-agentation-setup/SKILL.md">Setup skill ↗</a></dt><dd><code>gpui-agentation-setup</code> guides native library integration, screen registration, and debug and release verification.</dd></div>
          <div><dt><a class="inline-link" href="https://github.com/emmanuel-defreitas/gpui-agentation/blob/dev/skills/gpui-agentation-explore/SKILL.md">Exploration skill ↗</a></dt><dd><code>gpui-agentation-explore</code> discovers MCP tools, reads sessions and pending notes, exports Markdown, and guides requested fixes through acknowledgment, replies, and verified resolution. It also explains the native drawing tools and API limits.</dd></div>
        </dl>
        <p>From a repository clone, copy the chosen directory under <code>skills/</code> into your host project’s <code>.agents/skills/</code>, or <code>~/.agents/skills/</code> for personal use across projects. In Zed, start a new conversation and invoke <code>/gpui-agentation-explore</code> or <code>/gpui-agentation-setup</code>. Other agents can load the linked <code>SKILL.md</code> directly or use their supported skill directory.</p>
        <p class="notice">Try: “Use gpui-agentation-explore to discover my app’s MCP tools and summarize pending feedback without changing notes.” Connect the running debug app’s MCP server first; installing a skill provides instructions, not a server connection.</p>
        <p class="small-note">The linked skills track the <code>dev</code> branch. Use the skill from your host’s gpui-agentation revision when working with a pinned version.</p>
      </section>
      <section id="customization" class="doc-section"><h2>Make it fit your app.</h2><p>The integration points are small and explicit. Start with the defaults and adjust the context your agent needs.</p><dl class="options"><div><dt>App name & route</dt><dd>Name the app when mounting. Call <code>set_route(url, window, cx)</code> on navigation to group saved feedback by screen.</dd></div><div><dt>Selectable components</dt><dd>Choose which component roots to register with <code>target(id, label, child)</code>. Keep IDs stable and unique within the window.</dd></div><div><dt>Storage</dt><dd>Set a local JSON path when mounting. Use one running app process per store file; keep feedback files out of version control.</dd></div><div><dt>Local port</dt><dd>Change the mount port if <code>4748</code> is in use, and match it in your MCP client’s <code>--url</code>. A busy port leaves local notes usable.</dd></div><div><dt>Drawing tools</dt><dd>Use Inspect, Box, Arrow, and Pen in the native toolbar. Four built-in color swatches distinguish drawing strokes.</dd></div><div><dt>Build features</dt><dd>Use <code>native</code> for the debug library, default <code>mcp</code> for the bridge, or both when developing this package.</dd></div></dl><p class="small-note">Version 0.4.2 does not expose a public toolbar layout or custom palette builder.</p>
      </section>
      <section id="credits" class="doc-section credits"><h2>A familiar idea.<br>A native implementation.</h2><p>Inspired by <a href="https://www.agentation.com/">Agentation</a> and its approach to giving agents precise visual feedback. Thank you for the inspiration.</p><p>gpui-agentation is an independent Rust implementation for GPUI. It is not affiliated with Agentation and does not implement its complete protocol. The native interface uses bundled <a href="https://elygpui.com/">Ely components</a>; upstream licenses and attribution are preserved.</p><div class="credits-links"><a href="https://github.com/emmanuel-defreitas/gpui-agentation">Project source <span aria-hidden="true">↗</span></a><a href="https://github.com/emmanuel-defreitas/gpui-agentation/blob/main/LICENSE">MIT license <span aria-hidden="true">↗</span></a><a href="https://www.agentation.com/">Agentation <span aria-hidden="true">↗</span></a></div></section>
    </div>
  </div>
</main>
<footer class="wrap"><a class="brand" href="#"><img src={`${base}assets/mark.svg`} alt="" width="22" height="22">gpui-agentation</a><span>Made for the details.</span><a href="#installation">Get started <span aria-hidden="true">↑</span></a></footer>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
</body>
</html>
