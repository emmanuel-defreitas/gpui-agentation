+    /// Presents the inspector in another window without reserving sidebar space.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn set_inspector_external(&mut self, external: bool) {
+        self.inspector_external = external;
+        self.refresh();
+    }
+
+    /// The native picker/controller, which may be rendered in an external window.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn inspector_entity(&self) -> Option<Entity<Inspector>> {
+        self.inspector.clone()
+    }
+
+    /// Resolves a saved inspection anchor against this window's live hitboxes.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn inspection_anchor(&self, key: &str) -> Option<(crate::InspectorElementId, Bounds<Pixels>)> {
+        let frame = if self.invalidator.not_drawing() { &self.rendered_frame } else { &self.next_frame };
+        let canonical = |key: &str| {
+            let (path, source) = key.split_once('@')?;
+            let path = path.split('.').filter(|segment| !segment.trim_start_matches("gpui:").starts_with("view-")).collect::<Vec<_>>().join(".");
+            Some((path.trim_start_matches("gpui:").to_owned(), source.to_owned()))
+        };
+        let wanted = canonical(key)?;
+        let mut fallback = None;
+        let mut ambiguous = false;
+        for (hitbox_id, id) in &frame.inspector_hitboxes {
+            let source = id.path.source_location;
+            let candidate = format!("gpui:{}@{}:{}:{}#{}", id.path.global_id, source.file(), source.line(), source.column(), id.instance_id);
+            let Some(hitbox) = frame.hitboxes.iter().find(|hitbox| hitbox.id == *hitbox_id) else { continue; };
+            let bounds = hitbox.bounds.intersect(&hitbox.content_mask.bounds);
+            if bounds.size.width <= px(0.) || bounds.size.height <= px(0.) { continue; }
+            if candidate == key { return Some((id.clone(), bounds)); }
+            if canonical(&candidate).as_ref() == Some(&wanted) {
+                ambiguous |= fallback.is_some();
+                fallback = Some((id.clone(), bounds));
+            }
+        }
+        if ambiguous { None } else { fallback }
+    }
+
+    /// Selects an existing element without synthesizing a pointer event.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn select_inspection_anchor(&mut self, key: &str, cx: &mut App) -> bool {
+        let Some((id, _)) = self.inspection_anchor(key) else { return false; };
+        let Some(inspector) = self.inspector.clone() else { return false; };
+        inspector.update(cx, |inspector, cx| { inspector.select(id, self); cx.notify(); });
+        self.refresh();
+        true
+    }
